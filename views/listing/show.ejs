<% layout('layouts/boilorPlate.ejs') %>
<div class="container-fluid py-3">
  <div class="row justify-content-center">
    <div class="col-12 d-flex justify-content-center">
      <div
        class="card shadow-lg border-0 rounded-4 overflow-hidden animate__animated animate__fadeInUp listing-card custom-wide-card"
      >
        <!-- Card Header -->
        <div class="card-header listing-header py-1">
          <h1 class="card-title mb-0 text-center fw-bold text-white">
            <i class="fas fa-home me-2"></i><%= Listing.title %>
          </h1>
        </div>

        <!-- Card Body -->
        <div class="card-body p-0">
          <!-- Image Section -->
          <% if (Listing.image && Listing.image.url) { %>
          <div class="position-relative overflow-hidden">
            <img
              src="<%= Listing.image.url %>"
              alt="Listing Image"
              class="w-100 listing-image"
              style="
                height: 200px;
                object-fit: cover;
                transition: transform 0.3s ease;
              "
            />
            <div class="position-absolute top-0 end-0 m-3">
              <span class="badge status-badge fs-6 px-3 py-2 <%= Listing.isBooked ? 'booked-tag' : 'available-tag' %>">
                <i class="fas fa-circle me-1"></i>
                <%= Listing.isBooked ? 'Booked' : 'Available' %>
              </span>
            </div>
          </div>
          <% } %>

          <!-- Content Section -->
          <div class="p-2 content-section">
            <!-- Description -->
            <div class="mb-3">
              <div class="mb-2 text-muted small">
                <i class="fas fa-user me-1"></i>
                Owner <strong><%= Listing.owner.username %></strong>
              </div>
              <h5 class="section-title mb-2">
                <i class="fas fa-info-circle me-2"></i>Description
              </h5>
              <p class="description-text"><%= Listing.description %></p>
            </div>

            <!-- Price and Location Section -->
            <div class="row mb-2 g-2">
              <div class="col-lg-6 col-md-6">
                <button 
                  type="button" 
                  class="info-card price-card price-card-clickable"
                  data-bs-toggle="modal" 
                  data-bs-target="#bookingModal"
                  style="border: none; background: none; width: 100%; cursor: pointer; padding: 0;"
                >
                  <h6 class="info-label">
                    <i class="fas fa-indian-rupee-sign me-1"></i>Price
                  </h6>
                  <h3 class="price-text">
                    &#8377;<%= Listing.price.toLocaleString("en-in") %>
                  </h3>
                </button>
              </div>
              <div class="col-lg-6 col-md-6">
                <a
                  href="<%= mapsUrl(Listing) %>"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-decoration-none text-reset d-block"
                >
                  <div class="info-card location-card">
                    <h6 class="info-label">
                      <i class="fas fa-map-marker-alt me-1"></i>Location
                      <i class="fas fa-up-right-from-square ms-1" aria-hidden="true"></i>
                    </h6>
                    <h5 class="location-text"><%= Listing.location %></h5>
                  </div>
                </a>
              </div>
            </div>

            <!-- Country -->
            <div class="mb-2">
              <a
                href="<%= mapsUrl(Listing) %>"
                target="_blank"
                rel="noopener noreferrer"
                class="text-decoration-none text-reset d-block"
              >
                <div class="info-card country-card">
                  <h6 class="info-label">
                    <i class="fas fa-globe me-1"></i>Country
                    <i class="fas fa-up-right-from-square ms-1" aria-hidden="true"></i>
                  </h6>
                  <h5 class="country-text"><%= Listing.country %></h5>
                </div>
              </a>
            </div>

            <!-- Action Buttons -->
            <div class="mb-3 d-flex gap-3 flex-wrap action-buttons">
              <% if (currentUser && Listing.owner.equals(currentUser._id)) { %>
                <a
                  href="/listing/<%= Listing._id %>/edit"
                  class="btn edit-btn btn-lg flex-fill animate__animated animate__pulse animate__infinite animate__slower"
                >
                  <i class="fas fa-edit me-2"></i>Edit Listing
                </a>
                <form
                  action="/listing/<%=Listing._id%>?_method=DELETE"
                  method="POST"
                  class="flex-fill"
                >
                  <button
                    type="submit"
                    class="btn delete-btn btn-lg w-100 animate__animated animate__pulse animate__infinite animate__slower"
                    onclick="return confirm('Are you sure you want to delete this listing?')"
                  >
                    <i class="fas fa-trash me-2"></i>Delete Listing
                  </button>
                </form>
              <% } else if (currentUser) { %>
                <% if (Listing.isBooked) { %>
                  <button type="button" class="btn btn-outline-danger btn-lg flex-fill disabled">
                    <i class="fas fa-ban me-2"></i>Already Booked
                  </button>
                <% } else { %>
                  <button
                    type="button"
                    class="btn btn-success btn-lg flex-fill"
                    data-bs-toggle="modal"
                    data-bs-target="#bookingModal"
                  >
                    <i class="fas fa-calendar-alt me-2"></i>Book Now
                  </button>
                <% } %>
              <% } else { %>
                <a href="/login" class="btn btn-primary btn-lg flex-fill">
                  <i class="fas fa-sign-in-alt me-2"></i>Login to Book
                </a>
              <% } %>
            </div>

            <% if (currentUser && Listing.owner.equals(currentUser._id)) { %>
              <div class="listing-owner-meta mt-3">
                <% if (Listing.isBooked) { %>
                  <span class="status-pill booked-pill">
                    <i class="fas fa-user-check me-1"></i>
                    Booked by <%= Listing.bookedBy?.username || 'a guest' %>
                  </span>
                <% } else { %>
                  <span class="status-pill available-pill">
                    <i class="fas fa-check-circle me-1"></i>
                    Currently available
                  </span>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<hr />
<% if(currentUser) {%>
<div class="review-form-container">
  <h4 class="review-form-title">Leave a Review</h4>
  <form
    action="/listing/<%= Listing._id %>/reviews"
    method="POST"
    novalidate
    class="needs-validation"
  >
    <div class="mb-3">
      <label for="rating" class="form-label" style="font-weight: 500"
        >Rating</label
      >
      <input
        type="range"
        min="1"
        max="5"
        name="review[rating]"
        class="form-range"
        style="width: 100%"
      />
      <div
        style="
          display: flex;
          justify-content: space-between;
          font-size: 0.9rem;
          color: var(--gray-color);
        "
      >
        <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
      </div>
    </div>
    <div class="mb-3">
      <label for="comment" class="form-label" style="font-weight: 500"
        >Comment</label
      >
      <textarea
        name="review[comment]"
        id="comment"
        class="form-control"
        rows="3"
        placeholder="Write your thoughts..."
        style="resize: vertical"
        required
      ></textarea>
    </div>
    <button
      type="submit"
      class="btn btn-primary btn-animate"
      style="
        background: var(--primary-color);
        border: none;
        border-radius: 0.5rem;
        padding: 0.5rem 1.5rem;
        font-weight: 500;
      "
    >
      Submit Review
    </button>
  </form>
</div>
<% } %>

<!-- Reviews Section -->
<div class="reviews-container">
  <h4 class="review-form-title">Reviews</h4>
  <div class="review-list">
    <!-- Debug info -->
    <p>Total reviews: <%= Listing.reviews ? Listing.reviews.length : 0 %></p>
    <% if(Listing.reviews && Listing.reviews.length > 0) { %> <% for(let review
    of Listing.reviews){ %>
    <div class="review-item d-flex align-items-center justify-content-between">
      <div>
        <div class="d-flex align-items-center mb-1">
          <i
            class="fas fa-user-circle me-2"
            style="font-size: 1.5rem; color: var(--primary-color)"
          ></i>
          <span style="font-weight: 600; font-size: 1.1rem"
            >@<%= review.author.username %></span
          >
        </div>
        <h5 class="review-rating mb-1">Rating: <%= review.rating %></h5>
        <p class="review-comment mb-0"><%= review.comment %></p>
      </div>
      <form
        action="/listing/<%= Listing._id %>/reviews/<%= review._id %>?_method=DELETE"
        method="POST"
        class="ms-3"
      >
        <button
          type="submit"
          class="btn btn-outline-danger btn-sm"
          title="Delete review"
          onclick="return confirm('Are you sure you want to delete this review?')"
        >
          <i class="fas fa-trash"></i>
        </button>
      </form>
    </div>
    <% } %> <% } %>
  </div>
</div>

<% if (!Listing.isBooked && currentUser && !Listing.owner.equals(currentUser._id)) { %>
<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content payment-modal-content">
      <div class="modal-header payment-modal-header">
        <h5 class="modal-title" id="bookingModalLabel">
          <i class="fas fa-calendar-alt me-2"></i>Reserve Your Stay
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body payment-modal-body">
        <div class="payment-summary mb-4">
          <div class="summary-row">
            <span class="summary-label">Listing Title:</span>
            <span class="summary-value"><%= Listing.title %></span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Rate per night:</span>
            <span class="summary-value price-highlight">&#8377;<%= Listing.price.toLocaleString("en-in") %></span>
          </div>
        </div>

        <div class="alert alert-danger d-none" id="bookingError"></div>
        <div class="alert alert-success d-none" id="bookingSuccess"></div>

        <form id="bookingForm" class="booking-form needs-validation" novalidate>
          <input type="hidden" id="bookingListingId" value="<%= Listing._id %>">
          <input type="hidden" id="bookingPrice" value="<%= Listing.price %>">

          <div class="row g-3">
            <div class="col-md-6">
              <label for="checkIn" class="form-label">Check-in Date</label>
              <input type="date" class="form-control" id="checkIn" required />
              <div class="invalid-feedback">Select a valid check-in date.</div>
            </div>
            <div class="col-md-6">
              <label for="checkOut" class="form-label">Check-out Date</label>
              <input type="date" class="form-control" id="checkOut" required />
              <div class="invalid-feedback">Select a valid check-out date.</div>
            </div>
            <div class="col-md-4">
              <label for="nightsCount" class="form-label">Nights</label>
              <input type="number" class="form-control" id="nightsCount" readonly value="1" />
            </div>
            <div class="col-md-4">
              <label for="roomsCount" class="form-label">Rooms</label>
              <input type="number" class="form-control" id="roomsCount" min="1" value="1" required />
              <div class="invalid-feedback">Enter how many rooms you want.</div>
            </div>
            <div class="col-md-4">
              <label for="totalGuests" class="form-label">Total Guests</label>
              <input type="text" class="form-control" id="totalGuests" readonly value="1 adult, 0 child" />
            </div>
            <div class="col-md-6">
              <label for="adultsCount" class="form-label">Adults</label>
              <input type="number" class="form-control" id="adultsCount" min="1" value="1" required />
              <div class="invalid-feedback">Provide adults count.</div>
            </div>
            <div class="col-md-6">
              <label for="childrenCount" class="form-label">Children</label>
              <input type="number" class="form-control" id="childrenCount" min="0" value="0" required />
              <div class="invalid-feedback">Provide children count (0 if none).</div>
            </div>
          </div>

          <div class="booking-total mt-4 p-3 rounded-3 bg-light">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold">Total Amount</span>
              <span class="fw-bold fs-5" id="bookingAmount">&#8377;<%= Listing.price.toLocaleString("en-in") %></span>
            </div>
          </div>
        </form>
      </div>

      <div class="modal-footer payment-modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success payment-submit-btn" id="bookingSubmitBtn" form="bookingForm">
          <i class="fas fa-calendar-check me-2"></i>Book Now
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content payment-modal-content">
      <div class="modal-header payment-modal-header">
        <h5 class="modal-title" id="paymentModalLabel">
          <i class="fas fa-calendar-check me-2"></i>Confirm Booking
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body payment-modal-body">
        <div class="payment-summary mb-4">
          <div class="summary-row">
            <span class="summary-label">Listing Title:</span>
            <span class="summary-value"><%= Listing.title %></span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Check-in:</span>
            <span class="summary-value" id="paymentCheckIn">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Check-out:</span>
            <span class="summary-value" id="paymentCheckOut">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Rooms × Nights:</span>
            <span class="summary-value" id="paymentRoomsNights">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Amount:</span>
            <span class="summary-value price-highlight" id="paymentAmount">₹0</span>
          </div>
        </div>

        <div id="paymentError" class="alert alert-danger d-none"></div>

        <div class="payment-method-selector mb-4">
          <div class="btn-group w-100" role="group">
            <input type="radio" class="btn-check" name="paymentMethod" id="upiMethod" value="upi" checked>
            <label class="btn btn-outline-primary payment-method-btn" for="upiMethod">
              <i class="fas fa-mobile-alt me-2"></i>UPI
            </label>

            <input type="radio" class="btn-check" name="paymentMethod" id="cardMethod" value="card">
            <label class="btn btn-outline-primary payment-method-btn" for="cardMethod">
              <i class="fas fa-credit-card me-2"></i>Card
            </label>
          </div>
        </div>

        <div id="upiSection" class="payment-section active">
          <form id="upiForm" class="upi-form needs-validation" novalidate>
            <div class="mb-3">
              <label for="upiName" class="form-label">Full Name</label>
              <input type="text" class="form-control" id="upiName" placeholder="John Doe" required />
              <div class="invalid-feedback">Please provide your name.</div>
            </div>
            <div class="mb-3">
              <label for="upiEmail" class="form-label">Email Address</label>
              <input type="email" class="form-control" id="upiEmail" placeholder="you@example.com" required />
              <div class="invalid-feedback">Please provide a valid email.</div>
            </div>
            <div class="mb-3">
              <label for="upiId" class="form-label">UPI ID <span class="text-muted">(optional)</span></label>
              <input type="text" class="form-control" id="upiId" placeholder="yourname@upi" />
              <small class="form-text text-muted">Optional</small>
            </div>
            <div class="mb-3">
              <label for="upiPhone" class="form-label">Phone Number</label>
              <input type="tel" class="form-control" id="upiPhone" placeholder="9876543210" maxlength="10" required />
              <div class="invalid-feedback">Please provide a valid 10-digit phone number.</div>
            </div>
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="upiTermsCheckbox" required />
              <label class="form-check-label" for="upiTermsCheckbox">I agree to the terms and conditions</label>
              <div class="invalid-feedback">You must agree to the terms.</div>
            </div>
          </form>
        </div>

        <div id="cardSection" class="payment-section" style="display: none;">
          <form id="paymentForm" class="payment-form needs-validation" novalidate>
            <div class="mb-3">
              <label for="cardholderName" class="form-label">Customer Name</label>
              <input type="text" class="form-control" id="cardholderName" placeholder="John Doe" required />
              <div class="invalid-feedback">Please provide your name.</div>
            </div>
            <div class="mb-3">
              <label for="paymentEmail" class="form-label">Email Address</label>
              <input type="email" class="form-control" id="paymentEmail" placeholder="you@example.com" required />
              <div class="invalid-feedback">Please provide a valid email.</div>
            </div>
            <div class="mb-3">
              <label for="cardPhone" class="form-label">Phone Number</label>
              <input type="tel" class="form-control" id="cardPhone" placeholder="9876543210" maxlength="10" required />
              <div class="invalid-feedback">Please provide a valid 10-digit phone number.</div>
            </div>
            <div class="form-check mb-4">
              <input class="form-check-input" type="checkbox" id="termsCheckbox" required />
              <label class="form-check-label" for="termsCheckbox">I agree to the terms and conditions</label>
              <div class="invalid-feedback">You must agree to the terms.</div>
            </div>
          </form>
        </div>
      </div>

      <div class="modal-footer payment-modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="paymentBackBtn">Back</button>
        <button type="button" class="btn btn-success payment-submit-btn" id="paymentSubmitBtn">
          <i class="fas fa-check me-2"></i>Confirm Booking <span id="paymentButtonAmount">₹0</span>
        </button>
      </div>
    </div>
  </div>
</div>
<% } %>

<script> const upiId = '<%= UPI_ID %>'; </script>
<script src="/js/booking.js"></script>
<script src="/js/payment.js"></script>

